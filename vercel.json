{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "build": {
    "env": {
      "VITE_API_BASE_URL": "https://api.msp-overlay.store",
      "VITE_GOOGLE_LOGIN_URL": "https://api.msp-overlay.store/api/auth/google",
      "VITE_WINDOWS_APP_DOWNLOAD_URL": "https://github.com/okkk2010/msp-windows/releases/latest"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
